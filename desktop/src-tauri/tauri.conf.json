{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vectrabot",
  "version": "1.0.4",
  "identifier": "in.xibeai.vectrabot",
  "build": {
    "frontendDist": "../../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vectrabot",
        "width": 1440,
        "height": 900,
        "minWidth": 420,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http: https: ws: wss: ipc: http://ipc.localhost; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; frame-src https: data: blob:; media-src 'self' blob: data:;"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
